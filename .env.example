# Copy this file to .env and fill in values. Never commit .env.

# Application
APP_NAME=SimilarMusic
DEBUG=false

# SQLite database location (relative to the project root)
DATABASE_URL=sqlite:///./similarmusic.db

# Timeout in seconds for every external API request
HTTP_TIMEOUT_SECONDS=10

# Spotify Web API — https://developer.spotify.com/dashboard
# Create an app, select "Web API", then copy the Client ID and Client Secret.
# Development Mode apps require the app owner to have Spotify Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Two-letter country code used to check track availability
SPOTIFY_MARKET=US

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Enable the API for a Google Cloud project, then create an API key under
# "APIs & Services > Credentials". Each song lookup costs 1 unit of the 10,000/day quota.
YOUTUBE_API_KEY=

# Last.fm API — https://www.last.fm/api/account/create
# Create an API account (free, non-commercial use) and copy the API key.
# Used to find similar tracks and artists and to read genre/mood tags.
LASTFM_API_KEY=

# Claude API — https://platform.claude.com/
# Used to analyse songs, evaluate candidates and write explanations.
ANTHROPIC_API_KEY=
# Model and reasoning effort (low, medium, high, xhigh, max).
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=120

# Number of recommendations returned, and how long results are reused.
RECOMMENDATION_COUNT=10
RECOMMENDATION_CACHE_HOURS=24
# Recommendation requests one client (IP address) may make per hour; 0 = unlimited.
RECOMMENDATIONS_PER_CLIENT_PER_HOUR=30
